@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Qt6::Core is a public dependency: the wire types are exposed as
# QJsonValue / QJsonObject, so consumers need QtCore on their include and
# link paths.
find_dependency(Qt6 6.4 COMPONENTS Core)

# The optional HTTP transport (mcp::http) is compiled with QtNetwork +
# QtHttpServer. Only required when this build of mcp was compiled with
# MCP_ENABLE_HTTP=ON.
if(@MCP_ENABLE_HTTP@)
    find_dependency(Qt6 6.4 COMPONENTS Network HttpServer)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mcp-targets.cmake")
check_required_components(mcp)
